# Listful Thinking self-hosting example configuration
#
# Copy this file to .env and edit values before using compose.prod.yml:
#
#   cp .env.example .env
#   docker compose --env-file .env -f compose.prod.yml up --build -d
#
# Defaults are private/local safe. Public internet deployment requires HTTPS in
# a reverse proxy and explicit opt-in to secure cookie settings.

# Required / identity
SYSTEM_LANG=en
# URL users should open. For public HTTPS, use https://lists.example.org.
PUBLIC_BASE_URL=http://localhost:8080

# Account bootstrap and registration
# Keep false after the first admin account exists; create later users from Admin.
REGISTRATION_ENABLED=false

# Session / browser security
# Use false only for private HTTP. Set true when PUBLIC_BASE_URL is HTTPS.
SESSION_COOKIE_SECURE=false
# Keep CSRF enabled unless you are doing a narrow local debugging session.
CSRF_ENABLED=true

# Reverse proxy / client IP handling
# Leave false unless a trusted reverse proxy strips/overwrites inbound X-Forwarded-For.
TRUST_FORWARDED_FOR=false

# Request-size and rate-limit controls
# Must remain above the 5,000,000-character image data URL limit plus JSON overhead.
MAX_REQUEST_BODY_BYTES=5100000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_BUCKETS=10000

# URL metadata scraper
# Keep false for normal deployments; true allows private/local network scraping.
SCRAPER_ALLOW_PRIVATE_ADDRESSES=false

# Optional mail. Leave empty to use username/password login and in-app notifications only.
MAIL_HOST=
MAIL_PORT=25
MAIL_USER=
MAIL_PASS=

# Production Compose host binding
# Default binds to localhost so a same-host reverse proxy can reach the app while
# the app port is not directly public. Set to a private LAN/Tailnet IP if needed.
LISTFUL_BIND=127.0.0.1
LISTFUL_PORT=8080

# Production data path on the host. The container writes as UID/GID 1000:1000.
LISTFUL_DATA_BIND=./data
