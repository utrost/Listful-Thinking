# Copy to .env.public and set your domain and a published, versioned image.
LISTFUL_DOMAIN=lists.example.org
PUBLIC_BASE_URL=https://lists.example.org
# Use this tag after its CI publish succeeds, or replace it with its immutable digest.
LISTFUL_IMAGE=ghcr.io/utrost/listful-thinking:v0.2.0-rc.3
REGISTRATION_ENABLED=false
SYSTEM_LANG=en
MAIL_HOST=
MAIL_PORT=25
MAIL_USER=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=
