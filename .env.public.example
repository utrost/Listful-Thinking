# Copy to .env.public and set your domain and a published, versioned image.
LISTFUL_DOMAIN=lists.example.org
PUBLIC_BASE_URL=https://lists.example.org
# RC3 public multiarch image, pinned to its immutable digest.
LISTFUL_IMAGE=ghcr.io/utrost/listful-thinking@sha256:c16ef4edd27a6ff367e84ef8451d6d7a00ce10d644259939887b2a786ecbe743
REGISTRATION_ENABLED=false
SYSTEM_LANG=en
# Optional map tile provider. The default uses OpenStreetMap only when a member opens Map.
# For substantial public traffic, use a tile provider with suitable capacity and attribution.
# LISTFUL_MAP_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
# LISTFUL_MAP_ATTRIBUTION=© Your tile provider
MAIL_HOST=
MAIL_PORT=25
MAIL_USER=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=
