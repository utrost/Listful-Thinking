{
  "name": "listful-thinking-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest --run",
    "test:gui": "playwright test",
    "test:gui:smoke": "playwright test --grep @smoke",
    "test:gui:sharing": "playwright test --grep @sharing",
    "test:gui:mobile": "playwright test --grep @mobile --project=chromium-mobile",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
