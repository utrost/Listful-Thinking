{
  "name": "listful-thinking-frontend",
  "version": "0.2.0-rc.3",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest --run",
    "test:gui": "playwright test",
    "test:gui:smoke": "playwright test --grep @smoke",
    "test:gui:sharing": "playwright test --grep @sharing",
    "test:gui:mobile": "playwright test --grep @mobile --project=chromium-mobile",
    "docs:screenshots": "playwright test tests/gui/docs-screenshots.spec.ts",
    "docs:demo": "playwright test tests/gui/docs-demo.spec.ts --project=chromium-desktop",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "leaflet": "1.9.4",
    "vue": "3.5.42",
    "vue-i18n": "11.4.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "1.9.22",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "21.0.4",
    "typescript": "~5.9.3",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "vue-tsc": "^3.3.11"
  }
}
